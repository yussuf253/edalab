        <div class="bc-foot">
          <div class="bc-inf"><span class="bc-inf-part">${getInlineIconMarkup('clock', 'bc-inf-icon')} ${b.t}</span><span class="bc-inf-sep">·</span><span class="bc-inf-part">${getInlineIconMarkup('delivery', 'bc-inf-icon')} ${b.d}</span></div>
