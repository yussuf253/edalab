/* ═══════════════════════════════════════════
   eDalab — Brand: Green #1DB954-style vibrant
   Humanized, warm, community-forward
═══════════════════════════════════════════ */
:root{
  --g:       #16A34A;
  --g-dark:  #15803D;
  --g-deep:  #14532D;
  --g-light: #DCFCE7;
  --g-pale:  #F0FDF4;
  --g-grad:  linear-gradient(135deg,#16A34A 0%,#22C55E 100%);
  --g-grad2: linear-gradient(135deg,#15803D 0%,#16A34A 60%,#4ADE80 100%);

  --food-c: #EF4444; --food-bg:#FEF2F2;
  --shop-c: #8B5CF6; --shop-bg:#F5F3FF;
  --doc-c:  #3B82F6; --doc-bg: #EFF6FF;
  --hotel-c:#F59E0B; --hotel-bg:#FFFBEB;
  --ride-c: #06B6D4; --ride-bg: #ECFEFF;
  --rx-c:   #10B981; --rx-bg:  #ECFDF5;
  --svc-c:  #F97316; --svc-bg: #FFF7ED;
  --wash-c: #6366F1; --wash-bg:#EEF2FF;

  --bg:    #F8FBF8;
  --white: #FFFFFF;
  --text:  #111827;
  --sub:   #6B7280;
  --muted: #9CA3AF;
  --border:#E5E7EB;

  --r-sm: 12px; --r-md:16px; --r-lg:24px; --r-xl:32px; --r-pill:999px;
  --sh-sm: 0 1px 3px rgba(0,0,0,0.06),0 1px 2px rgba(0,0,0,0.04);
  --sh-md: 0 4px 20px rgba(0,0,0,0.07),0 1px 4px rgba(0,0,0,0.04);
  --sh-lg: 0 12px 48px rgba(0,0,0,0.1),0 4px 12px rgba(0,0,0,0.05);
  --sh-xl: 0 24px 72px rgba(0,0,0,0.12),0 8px 24px rgba(0,0,0,0.06);
  --sh-green: 0 8px 32px rgba(22,163,74,0.25);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;-webkit-font-smoothing:antialiased;line-height:1.6}
h1,h2,h3,h4{font-family:'Bricolage Grotesque',sans-serif;line-height:1.1;letter-spacing:-0.03em}
a{text-decoration:none;color:inherit}
button{font-family:'Nunito',sans-serif;cursor:pointer;border:none}
input,textarea{font-family:'Nunito',sans-serif;border:none;outline:none}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-thumb{background:var(--g);border-radius:2px}

/* ═══ LAYOUT ═══ */
.wrap{max-width:1260px;margin:0 auto;padding:0 28px}
@media(max-width:640px){.wrap{padding:0 16px}}

/* ═══ HERO ═══ */
.hero{
  min-height:100vh;display:flex;align-items:center;
  padding-top:70px;position:relative;overflow:hidden;
}
/* Organic background */
.hero-bg{position:absolute;inset:0;background:linear-gradient(160deg,#F0FDF4 0%,#DCFCE7 30%,#F8FBF8 60%,#fff 100%)}
.hero-circles{position:absolute;inset:0;overflow:hidden}
.hc{position:absolute;border-radius:50%;opacity:0.06}
.hc1{width:700px;height:700px;background:var(--g);top:-200px;right:-150px;animation:hc-float 14s ease-in-out infinite}
.hc2{width:500px;height:500px;background:#22C55E;bottom:-200px;left:-100px;animation:hc-float 18s ease-in-out infinite reverse;animation-delay:-6s}
.hc3{width:350px;height:350px;background:#4ADE80;top:40%;left:30%;animation:hc-float 11s ease-in-out infinite;animation-delay:-3s}
@keyframes hc-float{0%,100%{transform:translate(0,0)}33%{transform:translate(20px,-25px)}66%{transform:translate(-15px,18px)}}
/* Dot pattern */
.hero-dots{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(22,163,74,0.08) 1.5px,transparent 1.5px);background-size:30px 30px;-webkit-mask-image:radial-gradient(ellipse 70% 70% at 50% 50%,black 40%,transparent 80%)}

.hero-inner{
  position:relative;z-index:1;width:100%;
  display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;
  max-width:1260px;margin:0 auto;padding:64px 28px;
}
@media(max-width:900px){.hero-inner{grid-template-columns:1fr;gap:48px;padding:48px 16px;text-align:center}}

.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--g-light);border:1.5px solid rgba(22,163,74,0.2);
  border-radius:var(--r-pill);padding:6px 14px 6px 8px;margin-bottom:24px;
}
.heb-av{
  width:28px;height:28px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 12px rgba(22,163,74,.14);overflow:hidden;flex-shrink:0;
}
.heb-av img{width:18px;height:18px;object-fit:contain;display:block}
.heb-text{font-size:13px;font-weight:700;color:var(--g-deep)}

h1.hero-h{font-size:clamp(44px,5.5vw,80px);font-weight:800;margin-bottom:22px;color:var(--text)}
html[lang="fr"] h1.hero-h{font-size:clamp(38px,4.9vw,68px)}
.hero-h .big-word{color:var(--g);display:block;position:relative}
html[lang="fr"] .hero-h br{display:none}
html[lang="fr"] .hero-h .big-word{display:inline-block}
.hero-h .big-word::after{
  content:'';position:absolute;left:0;right:0;bottom:-4px;height:4px;
  background:linear-gradient(90deg,var(--g),#4ADE80);border-radius:2px;
}

.hero-p{font-size:18px;color:var(--sub);line-height:1.7;max-width:480px;margin-bottom:36px;font-weight:500}
@media(max-width:900px){.hero-p{margin-left:auto;margin-right:auto}}

.hero-search{
  display:flex;align-items:center;background:#fff;border-radius:var(--r-xl);
  border:1.5px solid var(--border);box-shadow:var(--sh-xl);overflow:hidden;
  margin-bottom:28px;
}
.hs-location{
  display:flex;align-items:center;gap:6px;padding:0 18px;
  border-right:1.5px solid var(--border);font-size:13px;font-weight:700;
  color:var(--g-deep);white-space:nowrap;background:var(--g-pale);
}
.hs-input{flex:1;padding:18px 18px;font-size:15px;font-weight:600;color:var(--text);background:#fff}
.hs-input::placeholder{color:var(--muted);font-weight:500}
.hs-btn{margin:6px;padding:12px 22px;border-radius:20px;background:var(--g-grad);color:#fff;font-size:14px;font-weight:800;box-shadow:var(--sh-green);transition:all .2s;white-space:nowrap}
.hs-btn:hover{transform:scale(1.03);box-shadow:0 8px 28px rgba(22,163,74,0.4)}
@media(max-width:640px){
  .hero-search{flex-direction:column;align-items:stretch;border-radius:24px}
  .hs-location{border-right:none;border-bottom:1.5px solid var(--border);justify-content:center;padding:12px 18px}
  .hs-input{padding:16px 18px}
  .hs-btn{margin:0 12px 12px}
}

.hero-pills{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.hero-pill-tag{
  display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:var(--r-pill);
  background:#fff;border:1.5px solid var(--border);font-size:13px;font-weight:700;color:var(--sub);
  box-shadow:var(--sh-sm);transition:all .2s;
}
.hero-pill-tag:hover{border-color:var(--g);color:var(--g);transform:translateY(-2px);box-shadow:0 4px 12px rgba(22,163,74,0.15)}
.hero-pill-icon,
.hero-float-icon,
.si-icon,
.module-chip-icon,
.app-tag-icon,
.dl-btn-ico,
.newsletter-title-icon,
.ft-soc,
.bc-inf-icon,
.meta-inline-icon,
.dr-meta-icon,
.toast-icon-mark,
.drawer-brand-mark,
.menu-item-mark,
.hiw-circle,
.featured-label-icon,
.testi-label-icon{
  display:inline-flex;align-items:center;justify-content:center;
}
.hero-pill-icon{
  width:20px;height:20px;border-radius:8px;background:var(--g-light);color:var(--g);flex-shrink:0;
}
.hero-pill-icon img,.hero-float-icon img,.si-icon img,.module-chip-icon img,.drawer-brand-mark img{
  width:14px;height:14px;object-fit:contain;display:block;
}
.hero-pill-icon img,.module-chip-icon img{width:13px;height:13px}
.hero-pill-icon svg,.hero-float-icon svg,.si-icon svg,.app-tag-icon svg,.dl-btn-ico svg,.newsletter-title-icon svg,.ft-soc svg,.bc-inf-icon svg,.meta-inline-icon svg,.dr-meta-icon svg,.toast-icon-mark svg,.menu-item-mark svg,.hiw-circle svg,.featured-label-icon svg,.testi-label-icon svg{
  width:14px;height:14px;display:block;
}

/* HERO RIGHT */
.hero-visual{position:relative;height:560px;display:flex;align-items:center;justify-content:center}
@media(max-width:900px){.hero-visual{height:auto}}
.hero-showcase-image{
  width:100%;
  max-width:300px;
  border-radius:32px;
  display:block;
  object-fit:cover;
  box-shadow:0 28px 80px rgba(22,163,74,0.24);
  border:1.5px solid rgba(255,255,255,0.85);
}
@media(max-width:900px){.hero-showcase-image{max-width:240px;margin:0 auto}}
.hero-showcase-wrap{position:relative;display:flex;align-items:center;justify-content:center}
.hero-float-card{
  position:absolute;
  background:#fff;
  border:1px solid rgba(22,163,74,.14);
  border-radius:18px;
  box-shadow:0 18px 44px rgba(22,163,74,.16);
  padding:12px 14px;
  display:flex;
  align-items:center;
  gap:8px;
  min-width:170px;
}
.hero-float-card.left-top{top:6px;left:-138px;animation:hero-float-left 5.6s ease-in-out infinite}
.hero-float-card.right-mid{top:118px;right:-150px;animation:hero-float-right 6.2s ease-in-out infinite}
.hero-float-card.left-bottom{bottom:18px;left:-146px;animation:hero-float-left 6.8s ease-in-out infinite;animation-delay:-1.4s}
.hero-float-icon{
  width:34px;
  height:34px;
  border-radius:10px;
  flex-shrink:0;
  background:var(--g-light);
  color:var(--g);
}
.hero-float-icon img{width:18px;height:18px}
.hero-float-icon svg{width:18px;height:18px}
.hero-float-card{
  backdrop-filter:blur(12px);
}
.hero-float-title{font-size:13px;font-weight:800;color:var(--g-deep);line-height:1.2}
.hero-float-sub{font-size:11px;font-weight:700;color:var(--g-dark);margin-top:2px}
@keyframes hero-float-left{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-10px)}
}
@keyframes hero-float-right{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(10px)}
}
@media(max-width:900px){.hero-float-card{display:none}}

/* ═══ STATS ═══ */
.stats-row{
  background:#fff;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:24px 28px;
}
.stats-inner{max-width:1260px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.stat-it{display:flex;align-items:center;gap:12px}
.si-icon{width:46px;height:46px;border-radius:13px;flex-shrink:0;color:var(--g)}
.si-icon img{width:22px;height:22px}
.si-icon svg{width:22px;height:22px}
.si-val{font-family:'Bricolage Grotesque',sans-serif;font-size:26px;font-weight:800;letter-spacing:-0.04em;line-height:1;color:var(--text)}
.si-lbl{font-size:12px;color:#4B5563;font-weight:700;margin-top:2px;text-transform:uppercase;letter-spacing:.04em}
.stat-div{width:1px;height:52px;background:var(--border)}
@media(max-width:900px){.stats-inner{justify-content:center}.stat-div{display:none}}
@media(max-width:640px){.stats-row{padding:18px 16px}.stat-it{width:calc(50% - 12px)}.si-val{font-size:22px}.si-lbl{font-size:11px}}
@media(max-width:420px){.stat-it{width:100%}}

/* ═══ SERVICES GRID ═══ */
.services-sec{padding:88px 0}
.sec-label{display:inline-flex;align-items:center;gap:6px;padding:5px 14px;border-radius:var(--r-pill);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;margin-bottom:14px}
h2.sec-h{font-size:clamp(32px,4vw,54px);font-weight:800;margin-bottom:10px}
.sec-p{font-size:17px;color:var(--sub);line-height:1.65;max-width:500px}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:48px}
@media(max-width:640px){.sec-head{flex-direction:column;align-items:flex-start}}
.see-all-btn{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:800;color:var(--g-deep);padding:10px 20px;border-radius:10px;background:var(--g-pale);border:1.5px solid rgba(20,83,45,0.18);transition:all .2s;white-space:nowrap}
.see-all-btn:hover{background:var(--g-dark);color:#fff;border-color:var(--g-dark)}

.svcs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:900px){.svcs-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:640px){.svcs-grid{grid-template-columns:repeat(4,1fr);gap:10px}}
@media(max-width:400px){.svcs-grid{grid-template-columns:repeat(2,1fr)}}

.svc-card{
  background:#fff;border-radius:var(--r-lg);border:1.5px solid var(--border);
  padding:24px 20px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;
  cursor:pointer;transition:all .3s;box-shadow:var(--sh-sm);position:relative;overflow:hidden;
}
.svc-card::before{content:'';position:absolute;inset:0;opacity:0;transition:opacity .3s;background:var(--svc-hover,#F0FDF4)}
.svc-card:hover::before{opacity:1}
.svc-card:hover{transform:translateY(-5px);box-shadow:var(--sh-lg);border-color:rgba(0,0,0,0.08)}
.svc-icon-wrap{
  width:64px;height:64px;border-radius:18px;
  display:flex;align-items:center;justify-content:center;font-size:30px;
  position:relative;z-index:1;transition:transform .3s;
}
.svc-icon-wrap img{width:34px;height:34px;object-fit:contain;display:block}
.svc-card:hover .svc-icon-wrap{transform:scale(1.1) rotate(-3deg)}
.svc-name{font-family:'Bricolage Grotesque',sans-serif;font-size:15px;font-weight:700;position:relative;z-index:1;margin-top:2px;color:var(--g-deep)}
.svc-count{font-size:12px;color:var(--sub);font-weight:600;position:relative;z-index:1}
.svc-tag{
  position:absolute;top:10px;right:10px;
  padding:3px 8px;border-radius:var(--r-pill);font-size:10px;font-weight:800;
  text-transform:uppercase;letter-spacing:.04em;
}

/* ═══ HOW IT WORKS ═══ */
.hiw-sec{padding:0 0 88px}
.hiw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;margin-top:52px}
.hiw-connector{position:absolute;top:36px;left:calc(12.5% + 18px);right:calc(12.5% + 18px);height:2px;background:linear-gradient(90deg,var(--g),#4ADE80);opacity:.15}
@media(max-width:768px){.hiw-grid{grid-template-columns:1fr 1fr;gap:28px}.hiw-connector{display:none}}
@media(max-width:480px){.hiw-grid{grid-template-columns:1fr}}
.hiw-step{text-align:center;padding:0 16px;position:relative;z-index:1}
.hiw-circle{
  width:72px;height:72px;border-radius:50%;margin:0 auto 18px;
  background:#fff;border:2px solid var(--border);box-shadow:var(--sh-md);
  transition:all .3s;
}
.hiw-circle svg{width:26px;height:26px;color:var(--g)}
.hiw-step:hover .hiw-circle{background:var(--g-grad);border-color:var(--g);box-shadow:var(--sh-green);transform:scale(1.08)}
.hiw-step:hover .hiw-circle svg{color:#fff}
.hiw-n{font-family:'Bricolage Grotesque',sans-serif;font-size:13px;font-weight:800;color:var(--g-deep);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}
.hiw-t{font-family:'Bricolage Grotesque',sans-serif;font-size:18px;font-weight:700;margin-bottom:8px}
.hiw-d{font-size:14px;color:var(--sub);line-height:1.6;font-weight:500}

/* ═══ FEATURED / STORES ═══ */
.featured-sec{padding:0 0 88px}
.filter-bar{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin-bottom:28px;padding-bottom:2px}
.filter-bar::-webkit-scrollbar{display:none}
.fchip{padding:8px 18px;border-radius:var(--r-pill);font-size:13px;font-weight:700;background:#fff;border:1.5px solid var(--border);color:var(--sub);white-space:nowrap;transition:all .2s}
.fchip:hover{border-color:var(--g);color:var(--g)}
.fchip.on{background:var(--g);border-color:var(--g);color:#fff}

.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:20px}
.biz-card{
  background:#fff;border-radius:var(--r-lg);border:1.5px solid var(--border);overflow:hidden;
  transition:all .3s;cursor:pointer;
}
.biz-card:hover{transform:translateY(-5px);box-shadow:var(--sh-xl);border-color:rgba(0,0,0,0.1)}
.bc-thumb{height:180px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.bc-emo{
  width:108px;height:108px;border-radius:30px;opacity:.18;position:absolute;
  display:flex;align-items:center;justify-content:center;filter:blur(1px);
}
.bc-emo img{width:68px;height:68px;object-fit:contain;display:block}
.bc-logo{
  width:60px;height:60px;border-radius:16px;background:#fff;
  box-shadow:var(--sh-md);display:flex;align-items:center;justify-content:center;
  position:absolute;bottom:-20px;left:16px;z-index:2;border:2px solid rgba(255,255,255,.8);
}
