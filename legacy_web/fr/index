    ar:{Food:'الطعام',Shopping:'التسوق',Doctor:'الطبيب',Hotel:'الفندق',Pharmacy:'الصيدلية',Services:'الخدمات',Ride:'المشاوير',Laundry:'الغسيل',All:'الكل'},
  };
  return labels[getHomeLanguage()]?.[name] || name;
}

function getHomeAvailableLabel(){
  const lang=getHomeLanguage();
  if(lang==='fr') return 'disponibles';
  if(lang==='ar') return 'متاح';
  return 'available';
}

