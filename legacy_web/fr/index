/* ── OPEN STORE DRAWER ── */
let cart={},cartTotal=0,activeBiz=null;
function openBiz(id){
  activeBiz=BIZS.find((item) => String(item.id)===String(id)) || BIZS[id];
  if(!activeBiz)return;
  const targetRoute = getTrendingRoute(activeBiz);
  if(targetRoute){
    window.location.href=targetRoute;
    return;
  }
  cart={};cartTotal=0;
  document.getElementById('d-emo').innerHTML=activeBiz.e?.includes('assets/')
    ? `<span class="drawer-brand-mark"><img src="../${activeBiz.e}" alt="${activeBiz.cat}"></span>`
    : getInitialsMark(activeBiz.n);
  document.getElementById('d-name').textContent=activeBiz.n;
  document.getElementById('d-meta').innerHTML=`
    <span>${getInlineIconMarkup('star', 'dr-meta-icon')} ${activeBiz.r} (${activeBiz.rv} reviews)</span>
    <span class="bc-badge ${activeBiz.open?'bc-open':'bc-closed'}" style="padding:3px 10px;border-radius:999px">${activeBiz.open?'Open Now':'Closed'}</span>
    <span>${getInlineIconMarkup('clock', 'dr-meta-icon')} ${activeBiz.t}</span><span>${getInlineIconMarkup('delivery', 'dr-meta-icon')} ${activeBiz.d}</span>
  `;
  let html='';
  activeBiz.menu.forEach(sec=>{
    html+=`<div class="dm-sec-title">${sec.cat}</div>`;
    sec.items.forEach((item,i)=>{
      html+=`<div class="dm-item">
        <div class="dm-thumb">${getDrawerItemMark(item)}</div>
        <div class="dm-info"><div class="dm-name">${item.n}</div><div class="dm-desc">${item.d}</div></div>
        <div class="dm-price">DJF ${item.p.toLocaleString()}</div>
        <button class="dm-add" onclick="addCart(${id},${i})">+</button>
      </div>`;
    });
  });
  document.getElementById('d-menu').innerHTML=html;
  updateCart();
  document.getElementById('overlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeDrawer(){
  document.getElementById('overlay').classList.remove('open');
  document.body.style.overflow='';
}

/* ── CART ── */
function addCart(bizId,itemIdx){
  const biz=BIZS.find((item) => String(item.id)===String(bizId)) || BIZS[bizId];
  const item=biz?.menu?.[0]?.items?.[itemIdx];
  if(!item)return;
  if(!cart[item.n])cart[item.n]={...item,qty:0};
  cart[item.n].qty++;cartTotal+=item.p;
  updateCart();popToast('Added: '+item.n,'cart');
}
function removeFromCart(key){
  if(!cart[key])return;
  cartTotal-=cart[key].p;cart[key].qty--;
  if(cart[key].qty<=0)delete cart[key];
  updateCart();
}
function updateCart(){
  const entries=Object.entries(cart);
  const count=entries.reduce((a,c)=>a+c[1].qty,0);
  document.getElementById('cart-bdg').textContent=count+' item'+(count!==1?'s':'');
  if(!entries.length){
    document.getElementById('cart-empty').style.display='flex';
    document.getElementById('cart-items').style.display='none';
    document.getElementById('cart-footer').style.display='none';
    return;
  }
  document.getElementById('cart-empty').style.display='none';
  document.getElementById('cart-items').style.display='flex';
  document.getElementById('cart-footer').style.display='block';
  document.getElementById('cart-items').innerHTML=entries.map(([k,v])=>`
    <div class="ci">
      <div class="ci-q">${v.qty}</div>
      <div class="ci-n">${v.n}</div>
      <div class="ci-p">DJF ${(v.p*v.qty).toLocaleString()}</div>
      <button class="ci-x" onclick="removeFromCart('${k}')">×</button>
    </div>
  `).join('');
  document.getElementById('csub').textContent='DJF '+cartTotal.toLocaleString();
  document.getElementById('ctotal').textContent='DJF '+(cartTotal+500).toLocaleString();
}
function placeOrder(){
  closeDrawer();goTrack();popToast('Order placed successfully!','spark');
}

/* ── ROUTING ── */
function goHome(){
  document.getElementById('home-pg').classList.remove('pg-hide');
  document.getElementById('track-pg').style.display='none';
  window.scrollTo(0,0);
}
function goTrack(){
  document.getElementById('home-pg').classList.add('pg-hide');
  document.getElementById('track-pg').style.display='block';
  window.scrollTo(0,0);
}

/* ── SEARCH ── */
function doSearch(){
  const q=document.getElementById('hero-q').value.toLowerCase().trim();
  if(!q)return;
  document.getElementById('browse').scrollIntoView({behavior:'smooth'});
  const filtered=BIZS.filter(b=>b.n.toLowerCase().includes(q)||b.sub.toLowerCase().includes(q)||b.cat.toLowerCase().includes(q));
  renderBiz(filtered.length?filtered:BIZS);
}
document.getElementById('hero-q').addEventListener('keydown',e=>{if(e.key==='Enter')doSearch()});

function scrollToBrowse(cat){
  document.getElementById('browse').scrollIntoView({behavior:'smooth'});
  const btn=[...document.querySelectorAll('.fchip')].find(b=>b.textContent===cat||b.textContent==='All');
  if(btn){
    activeTrendingFilter = cat;
    document.querySelectorAll('.fchip').forEach(c=>c.classList.remove('on'));
    btn.classList.add('on');
    renderBiz(getTrendingItems(cat));
  }
}

/* ── TOAST ── */
function popToast(msg,icon='spark'){
  const el=document.createElement('div');
  el.className='toast';
  const bgMap = {
    cart: 'var(--food-bg)',
    spark: 'var(--g-light)',
    mail: 'var(--g-light)',
    apple: 'rgba(255,255,255,.16)',
    playStore: 'rgba(255,255,255,.16)',
  };
  const iconMarkup = getInlineIconMarkup(icon, 'toast-icon-mark') || `<span class="toast-icon-mark">${icon}</span>`;
  el.innerHTML=`<div class="t-ico" style="background:${bgMap[icon] || '#F3F4F6'}">${iconMarkup}</div><span>${msg}</span>`;
  document.getElementById('toasts').appendChild(el);
  requestAnimationFrame(()=>el.classList.add('show'));
  setTimeout(()=>{el.classList.add('hide');setTimeout(()=>el.remove(),400)},2800);
}

/* ── NAV SCROLL ── */
window.addEventListener('scroll',()=>{
  document.getElementById('nav').classList.toggle('scrolled',scrollY>50);
});

/* ── INTERSECTION OBSERVER ── */
const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')});
},{threshold:.15});
document.querySelectorAll('.au').forEach(el=>obs.observe(el));

/* ── INIT ── */
UIComponents.mountUnifiedNavbar({active:'home',logoutRedirect:'index.html'});
renderSvcs();
renderTesti();
renderPartners();
renderTrendingLoading();
scheduleTrendingDataLoad();
</script>
