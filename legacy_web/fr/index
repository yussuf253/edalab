<script>
(() => {
  const root = document.documentElement;
  try {
    const savedPrefs = JSON.parse(localStorage.getItem('edaLabPreferences') || '{}');
    const pageLanguage = ['en', 'fr', 'ar'].includes(root.dataset.pageLanguage) ? root.dataset.pageLanguage : null;
    const savedLanguage = ['en', 'fr', 'ar'].includes(savedPrefs.language) ? savedPrefs.language : null;
    const resolvedLanguage = savedLanguage || pageLanguage || 'fr';
    root.lang = resolvedLanguage;
    root.dir = resolvedLanguage === 'ar' ? 'rtl' : 'ltr';
    if (savedLanguage && pageLanguage && savedLanguage !== pageLanguage) {
      root.setAttribute('data-i18n-pending', 'true');
      window.__edaI18nFailSafe = window.setTimeout(() => {
        root.removeAttribute('data-i18n-pending');
      }, 2500);
    }
  } catch (error) {
    root.lang = 'fr';
    root.dir = 'ltr';
    root.setAttribute('data-i18n-pending', 'true');
    window.__edaI18nFailSafe = window.setTimeout(() => {
      root.removeAttribute('data-i18n-pending');
    }, 2500);
  }
})();
</script>
