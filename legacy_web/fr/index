function updateTrendingFilters(){
  const categories = Array.from(new Set(BIZS.map((item) => item.cat).filter(Boolean)));
  FILTERS = ['All', ...categories];
}

function getTrendingItems(cat='All'){
  if(cat!=='All'){
    return BIZS.filter((item)=>item.cat===cat);
  }

  const grouped = new Map();
  BIZS.forEach((item) => {
    if(!item.cat) return;
    if(!grouped.has(item.cat)) grouped.set(item.cat, []);
    grouped.get(item.cat).push(item);
  });

  return Array.from(grouped.values()).flatMap((items) => items.slice(0, 3));
}

async function loadTrendingData(){
  try{
    const [restaurantsRes, doctorsRes, hotelsRes, providersRes] = await Promise.all([
      apiClient.getRestaurants({ limit: 4, skip: 0 }),
      apiClient.getDoctors({ limit: 3, skip: 0 }),
      apiClient.getHotels({ limit: 3, skip: 0 }),
      apiClient.getHomeServiceProviders('', { limit: 3, skip: 0 }),
    ]);

    const restaurants = (Array.isArray(restaurantsRes) ? restaurantsRes : (restaurantsRes.data || [])).map((item) => ({
      id: `food-${item.id}`,
      sourceId: item.id,
      n: item.name,
      e: getModuleIconPath('Food'),
      sub: item.cuisine || item.type || 'Restaurant',
      r: Number(item.rating || 4.5).toFixed(1),
      rv: item.reviewCount || 0,
      t: `${item.deliveryTime || '30-40'} min`,
      d: item.deliveryFee ? `$${Number(item.deliveryFee).toFixed(2)}` : 'Free',
      open: item.isOpen !== false,
      cat: 'Food',
      bg: 'linear-gradient(135deg,#FFF0EF,#FFE0DC)',
      route: `restaurant-detail.html?id=${item.id}`,
    }));

    const doctors = (Array.isArray(doctorsRes) ? doctorsRes : (doctorsRes.data || [])).map((item) => ({
      id: `doctor-${item.id}`,
      sourceId: item.id,
      n: item.name,
      e: getModuleIconPath('Doctor'),
      sub: `${item.specialty || 'Doctor'}${item.experience ? ` · ${item.experience}` : ''}`,
      r: Number(item.rating || 4.7).toFixed(1),
      rv: item.reviewCount || 0,
      t: 'Book Visit',
      d: item.consultationFee ? `$${Number(item.consultationFee).toFixed(2)}` : 'Available',
      open: item.isAvailable !== false,
      cat: 'Doctor',
      bg: 'linear-gradient(135deg,#EFF6FF,#DBEAFE)',
      route: `doctor.html?doctorId=${item.id}`,
    }));

    const hotels = (Array.isArray(hotelsRes) ? hotelsRes : (hotelsRes.data || [])).map((item) => ({
      id: `hotel-${item.id}`,
      sourceId: item.id,
      n: item.name,
      e: getModuleIconPath('Hotel'),
      sub: item.location || item.description || 'Hotel',
      r: Number(item.rating || 4.6).toFixed(1),
      rv: item.reviewCount || 0,
      t: 'Book Now',
      d: item.pricePerNight ? `$${Number(item.pricePerNight).toFixed(2)}/night` : 'View rates',
      open: true,
      cat: 'Hotel',
      bg: 'linear-gradient(135deg,#F5F3FF,#EDE9FE)',
      route: `hotel.html?hotelId=${item.id}`,
    }));

    const providers = (Array.isArray(providersRes) ? providersRes : (providersRes.data || [])).map((item) => ({
      id: `service-${item.id}`,
      sourceId: item.id,
      n: item.name,
      e: getModuleIconPath('Services'),
      sub: item.title || item.category?.name || 'Home Service',
      r: Number(item.rating || 4.5).toFixed(1),
      rv: item.reviewCount || 0,
      t: 'Book Now',
      d: item.startingPrice ? `$${Number(item.startingPrice).toFixed(2)} starting` : 'View details',
      open: true,
      cat: 'Services',
      bg: 'linear-gradient(135deg,#FFF7ED,#FFEDD5)',
      route: 'home-services.html',
    }));

    const realItems = [...restaurants, ...doctors, ...hotels, ...providers].filter((item) => item?.n);
    if (realItems.length) {
      BIZS = realItems;
    } else {
      BIZS = [...FALLBACK_BIZS];
    }
  } catch (error) {
    console.error('Error loading trending data:', error);
    BIZS = [...FALLBACK_BIZS];
  }

  updateTrendingFilters();
}

function scheduleTrendingDataLoad(){
  const run = () => {
    loadTrendingData().finally(() => {
      renderFilters();
      renderBiz();
    });
  };

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(run, { timeout: 1800 });
    return;
  }

  window.setTimeout(run, 300);
}

/* ── RENDER BUSINESSES ── */
