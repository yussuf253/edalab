generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ModuleType {
  SHOPPING
  FOOD
  GROCERY
  HOME_SERVICES
  HOUSE_HELP
  PHARMACY
  DOCTOR
  HOTEL
  RIDE
  LAUNDRY
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum AppointmentStatus {
  UPCOMING
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HotelBookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum LaundryOrderStatus {
  PENDING
  SCHEDULED
  PICKED_UP
  CLEANING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ORDER
  APPOINTMENT
  PROMOTION
  RIDE
  LAUNDRY
  SYSTEM
}

enum NotificationModule {
  SYSTEM
  MESSAGES
  ORDERS
  FOOD
  SHOPPING
  GROCERY
  PHARMACY
  RIDE
  HOTEL
  DOCTOR
  HOME_SERVICES
  LAUNDRY
  PROMOTIONS
  ACCOUNT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  MACOS
  WINDOWS
  LINUX
  UNKNOWN
}

enum ConversationEntityType {
  DOCTOR
  HOME_SERVICE_PROVIDER
  SHOP
  DELIVERY
  RIDE
}

enum MessageSenderRole {
  USER
  PROVIDER
  DRIVER
  SYSTEM
}

enum PaymentMethodType {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  CASH
}

enum ProProfileType {
  SHOP
  PROVIDER
  DOCTOR
  DELIVERY
  RIDER
}

enum ProModule {
  SHOPPING
  FOOD
  PHARMACY
  SERVICES
  LAUNDRY
  DOCTOR
  SHOPPING_DELIVERY
  FOOD_DELIVERY
  PHARMACY_DELIVERY
  RIDE
}

model User {
  id                       String           @id @default(cuid())
  email                    String           @unique
  passwordHash             String
  firstName                String
  lastName                 String
  phone                    String?
  avatarUrl                String?
  dateOfBirth              DateTime?
  points                   Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  addresses                Address[]
  paymentMethods           PaymentMethod[]
  wishlistItems            WishlistItem[]
  notifications            Notification[]
  deviceTokens             DeviceToken[]
  conversations            Conversation[]   @relation("ConversationOwner")
  participantConversations Conversation[]   @relation("ConversationParticipant")
  orders                   Order[]
  appointments             Appointment[]
  hotelBookings            HotelBooking[]
  rideBookings             RideBooking[]
  laundryOrders            LaundryOrder[]
  userCoupons              UserCoupon[]
  proProfile               ProProfile?
  assignedDeliveryOrders   Order[]          @relation("DeliveryAssignee")
  assignedRideBookings     RideBooking[]    @relation("RideDriver")
  ownedLaundryServices     LaundryService[] @relation("LaundryServiceOwner")
}

model ProAccount {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  proProfile   ProProfile?
}

model ProProfile {
  id            String         @id @default(cuid())
  accountId     String?        @unique
  userId        String         @unique
  type          ProProfileType
  activeModules ProModule[]
  businessName  String
  avatarUrl     String?
  bindings      Json?
  isOnline      Boolean        @default(true)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  account       ProAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, updatedAt])
}

model Conversation {
  id                     String                 @id @default(cuid())
  userId                 String
  participantUserId      String?
  moduleType             ModuleType
  entityType             ConversationEntityType
  entityId               String
  title                  String
  subtitle               String?
  avatarUrl              String?
  accentColor            String?
  status                 String                 @default("OPEN")
  unreadCount            Int                    @default(0)
  userUnreadCount        Int                    @default(0)
  participantUnreadCount Int                    @default(0)
  lastMessage            String?
  lastMessageAt          DateTime?
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  participantUser        User?                  @relation("ConversationParticipant", fields: [participantUserId], references: [id], onDelete: SetNull)
  messages               Message[]

  @@unique([userId, entityType, entityId])
  @@index([userId, lastMessageAt])
  @@index([participantUserId, lastMessageAt])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderUserId   String?
  senderRole     MessageSenderRole
  senderLabel    String?
  body           String
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Address {
  id         String         @id @default(cuid())
  userId     String
  label      String
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  ridesFrom  RideBooking[]  @relation("RidePickupAddress")
  ridesTo    RideBooking[]  @relation("RideDropoffAddress")
  laundry    LaundryOrder[]

  @@index([userId, isDefault])
}

model PaymentMethod {
  id            String            @id @default(cuid())
  userId        String
  type          PaymentMethodType
  brand         String?
  last4         String?
  providerRef   String?
  expiryMonth   Int?
  expiryYear    Int?
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  hotelBookings HotelBooking[]
  rideBookings  RideBooking[]
  laundryOrders LaundryOrder[]
}

model WishlistItem {
  id         String     @id @default(cuid())
  userId     String
  moduleType ModuleType
  entityId   String
  title      String
  subtitle   String?
  imageUrl   String?
  price      Decimal?   @db.Decimal(10, 2)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleType, entityId])
  @@index([userId, createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  module    NotificationModule   @default(SYSTEM)
  priority  NotificationPriority @default(NORMAL)
  title     String
  body      String
  route     String?
  dedupeKey String?
  data      Json?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([userId, dedupeKey])
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform @default(UNKNOWN)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
}

model Promotion {
  id            String       @id @default(cuid())
  moduleType    ModuleType?
  title         String
  description   String
  code          String?      @unique
  discountType  String
  discountValue Decimal?     @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean      @default(true)
  priority      Int          @default(0)
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]
  userCoupons   UserCoupon[]

  @@index([moduleType, active, priority])
}

model UserCoupon {
  id          String    @id @default(cuid())
  userId      String
  promotionId String
  status      String    @default("AVAILABLE")
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([userId, promotionId])
}

model AppModule {
  id         String     @id
  moduleType ModuleType @unique
  name       String
  slug       String     @unique
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([active, sortOrder])
}

model ProductCategory {
  id         String     @id
  moduleType ModuleType
  name       String
  slug       String     @unique
  sortOrder  Int        @default(0)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   Product[]
}

model ShoppingStore {
  id             String    @id
  name           String
  slug           String    @unique
  tagline        String?
  description    String?
  imageUrl       String?
  isOpen         Boolean   @default(true)
  rating         Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount    Int       @default(0)
  badge          String?
  minPrice       Decimal?  @db.Decimal(10, 2)
  maxPrice       Decimal?  @db.Decimal(10, 2)
  highlightsJson Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

model Product {
  id                   String           @id
  moduleType           ModuleType
  categoryId           String?
  shopId               String?
  name                 String
  brand                String?
  description          String
  price                Decimal          @db.Decimal(10, 2)
  originalPrice        Decimal?         @db.Decimal(10, 2)
  unit                 String?
  dosage               String?
  packageSize          String?
  requiresPrescription Boolean          @default(false)
  rating               Decimal          @default(0) @db.Decimal(3, 2)
  reviewCount          Int              @default(0)
  imageUrlsJson        Json?
  colorsJson           Json?
  sizesJson            Json?
  tagsJson             Json?
  featuresJson         Json?
  badge                String?
  inStock              Boolean          @default(true)
  isOrganic            Boolean          @default(false)
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  category             ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shop                 ShoppingStore?   @relation(fields: [shopId], references: [id], onDelete: SetNull)
  orderItems           OrderItem[]

  @@index([moduleType, categoryId])
  @@index([shopId])
}

model Restaurant {
  id             String                   @id
  name           String
  cuisine        String
  rating         Decimal                  @default(0) @db.Decimal(3, 2)
  reviewCount    Int                      @default(0)
  deliveryTime   String?
  deliveryFee    Decimal?                 @db.Decimal(10, 2)
  imageUrl       String?
  isOpen         Boolean                  @default(true)
  distanceKm     Decimal?                 @db.Decimal(10, 2)
  tagsJson       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  menuCategories RestaurantMenuCategory[]
}

model RestaurantMenuCategory {
  id           String               @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int                  @default(0)
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        RestaurantMenuItem[]
}

model RestaurantMenuItem {
  id                 String                 @id
  categoryId         String
  name               String
  description        String
  price              Decimal                @db.Decimal(10, 2)
  imageUrl           String?
  isPopular          Boolean                @default(false)
  isAvailable        Boolean                @default(true)
  customizationsJson Json?
  category           RestaurantMenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Doctor {
  id               String         @id
  name             String
  specialty        String
  providerType     String         @default("DOCTOR")
  rating           Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount      Int            @default(0)
  experience       String?
  consultationFee  Decimal        @db.Decimal(10, 2)
  isAvailable      Boolean        @default(true)
  isSignedUp       Boolean        @default(true)
  imageUrl         String?
  about            String?
  location         String?
  contactPhone     String?
  contactWhatsApp  String?
  languagesJson    Json?
  servicesJson     Json?
  careModesJson    Json?
  workingHoursJson Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reviews          DoctorReview[]
  appointments     Appointment[]
}

model HomeServiceCategory {
  id          String                @id
  name        String
  slug        String                @unique
  description String
  iconKey     String
  colorHex    String
  sortOrder   Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  providers   HomeServiceProvider[]
}

model HomeServiceProvider {
  id               String              @id
  categoryId       String
  name             String
  title            String
  rating           Decimal             @default(0) @db.Decimal(3, 2)
  reviewCount      Int                 @default(0)
  yearsExperience  String?
  startingPrice    Decimal             @db.Decimal(10, 2)
  isAvailable      Boolean             @default(true)
  isVerified       Boolean             @default(false)
  responseTime     String?
  imageUrl         String?
  about            String?
  location         String?
  contactPhone     String?
  servicesJson     Json?
  highlightsJson   Json?
  bookingModesJson Json?
  availabilityJson Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         HomeServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isAvailable])
}

model DoctorReview {
  id        String   @id @default(cuid())
  doctorId  String
  reviewer  String
  rating    Int
  comment   String
  dateLabel String?
  avatarUrl String?
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String            @id @default(cuid())
  userId          String
  doctorId        String
  appointmentAt   DateTime
  timeSlot        String
  appointmentType String
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([userId, appointmentAt])
}

model Hotel {
  id            String         @id
  name          String
  address       String
  city          String
  rating        Decimal        @default(0) @db.Decimal(3, 2)
  reviewsCount  Int            @default(0)
  pricePerNight Decimal        @db.Decimal(10, 2)
  amenitiesJson Json?
  description   String
  imageUrlsJson Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      HotelBooking[]
}

model HotelBooking {
  id              String             @id @default(cuid())
  userId          String
  hotelId         String
  paymentMethodId String?
  status          HotelBookingStatus @default(PENDING)
  roomType        String
  guestName       String
  guestEmail      String
  guestPhone      String?
  specialRequests String?
  checkInAt       DateTime
  checkOutAt      DateTime
  nights          Int
  guestCount      Int
  subtotal        Decimal            @db.Decimal(10, 2)
  serviceFee      Decimal            @db.Decimal(10, 2)
  tax             Decimal            @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel           Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId, checkInAt])
}

model RideCategory {
  id           String        @id
  name         String
  description  String
  capacity     Int
  basePrice    Decimal       @db.Decimal(10, 2)
  pricePerKm   Decimal       @db.Decimal(10, 2)
  etaLabel     String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  rideBookings RideBooking[]
}

model RideBooking {
  id               String         @id @default(cuid())
  userId           String
  driverUserId     String?
  rideCategoryId   String
  paymentMethodId  String?
  pickupAddressId  String?
  dropoffAddressId String?
  pickupLabel      String
  dropoffLabel     String
  distanceKm       Decimal        @db.Decimal(10, 2)
  estimatedFare    Decimal        @db.Decimal(10, 2)
  tax              Decimal        @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)
  status           RideStatus     @default(REQUESTED)
  etaLabel         String?
  driverName       String?
  driverPhone      String?
  vehicleName      String
  trackingData     Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverUser       User?          @relation("RideDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  rideCategory     RideCategory   @relation(fields: [rideCategoryId], references: [id], onDelete: Restrict)
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  pickupAddress    Address?       @relation("RidePickupAddress", fields: [pickupAddressId], references: [id], onDelete: SetNull)
  dropoffAddress   Address?       @relation("RideDropoffAddress", fields: [dropoffAddressId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([driverUserId, status, createdAt])
}

model LaundryService {
  id             String         @id
  providerUserId String?
  name           String
  description    String
  price          Decimal        @db.Decimal(10, 2)
  unit           String
  iconUrl        String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  providerUser   User?          @relation("LaundryServiceOwner", fields: [providerUserId], references: [id], onDelete: SetNull)
  laundryOrders  LaundryOrder[]

  @@index([providerUserId, active])
}

model LaundryOrder {
  id              String             @id @default(cuid())
  userId          String
  serviceId       String
  addressId       String?
  paymentMethodId String?
  status          LaundryOrderStatus @default(PENDING)
  itemBreakdown   Json
  itemCount       Int
  pickupAt        DateTime
  timeSlot        String
  subtotal        Decimal            @db.Decimal(10, 2)
  tax             Decimal            @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         LaundryService     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  address         Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId, pickupAt])
}

model Order {
  id               String         @id @default(cuid())
  userId           String
  deliveryUserId   String?
  moduleType       ModuleType
  status           OrderStatus    @default(PENDING)
  addressId        String?
  paymentMethodId  String?
  promotionId      String?
  moduleRefId      String?
  moduleRefType    String?
  subtotal         Decimal        @db.Decimal(10, 2)
  tax              Decimal        @db.Decimal(10, 2)
  deliveryFee      Decimal        @default(0) @db.Decimal(10, 2)
  discount         Decimal        @default(0) @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)
  currency         String         @default("USD")
  notes            String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAssignee User?          @relation("DeliveryAssignee", fields: [deliveryUserId], references: [id], onDelete: SetNull)
  address          Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  promotion        Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@index([userId, moduleType, createdAt])
  @@index([userId, status, createdAt])
  @@index([deliveryUserId, moduleType, status, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  externalRefId String?
  name          String
  brand         String?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  lineTotal     Decimal  @db.Decimal(10, 2)
  variant       String?
  color         String?
  size          String?
  metadata      Json?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
